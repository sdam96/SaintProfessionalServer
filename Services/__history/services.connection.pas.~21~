unit services.connection;

interface

uses
  System.SysUtils, Data.DB, FireDAC.Comp.Client, FireDAC.Stan.Param;

type
  ESaintDb = class(Exception);

  ISessionSaint = interface
    ['{C1060869-7E6E-4B25-8BFA-1D27F1B349AF}']
    function Connection: TFDConnection;
    procedure StartTransaction;
    procedure Commit;
    procedure Rollback;
    function InTransaction: Boolean;
    function ScalarInt(const ASql: string; const AParams: array of Variant): Int64;
    procedure Execute(const ASql: string; const AParams: array of Variant);
  end;

  TSessionSaint = class(TInterfacedObject, ISessionSaint)
  private
    FConn: TFDConnection;
    FOwn: Boolean;
    procedure PrepareSession;
  public
    constructor Create(AConn: TFDConnection; AOwn: Boolean = False);
    destructor Destroy; override;
    function Connection: TFDConnection;
    procedure StartTransaction;
    procedure Commit;
    procedure Rollback;
    function InTransaction: Boolean;
    function ScalarInt(const ASql: string; const AParams: array of Variant): Int64;
    procedure Execute(const ASql: string; const AParams: array of Variant);
  end;

implementation

{ TSessionSaint }

procedure TSessionSaint.Commit;
begin
  if FConn.InTransaction then FConn.Commit;
end;

function TSessionSaint.Connection: TFDConnection;
begin
  Result := FConn;
end;

constructor TSessionSaint.Create(AConn: TFDConnection; AOwn: Boolean);
begin
  inherited Create;
  FConn := AConn;
  FOwn := AOwn;
  PrepareSession;
end;

destructor TSessionSaint.Destroy;
begin
  if FOwn then FreeAndNil(FConn);
  inherited;
end;

procedure TSessionSaint.Execute(const ASql: string;
  const AParams: array of Variant);
begin

end;

function TSessionSaint.InTransaction: Boolean;
begin
  Result := FConn.InTransaction;
end;

procedure TSessionSaint.PrepareSession;
begin
  if not FConn.Connected then FConn.Connected := True;

  FConn.ExecSQL('SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci');
  FConn.ExecSQL('SET SESSION sql_mode = ''''');
  FConn.TxOptions.AutoCommit := False;
end;

procedure TSessionSaint.Rollback;
begin
  if FConn.InTransaction then FConn.Rollback;
end;

function TSessionSaint.ScalarInt(const ASql: string;
  const AParams: array of Variant): Int64;
begin

end;

procedure TSessionSaint.StartTransaction;
begin
  if not FConn.InTransaction then FConn.StartTransaction;
end;

end.
