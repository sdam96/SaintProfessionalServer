unit models.cjdetall;

interface

uses
  attributes, models.types;

type
  // Renglon de caja. Se inserta UNA fila por cobro de contado.
  // NUMREF lleva el numero de documento con sufijo 'R'.
  [Table('cjdetall')]
  [UniqueIndex('KeyCja01', 'CONTROL')]   // inferido, confirmar con DDL
  TCJDetall = class
  public
    [UniqueKey][NotNull][Size(19)] CONTROL: string;
    [Indexed][Size(10)] CODCAJA: string;        // 'DEMO' en el dump
    [Indexed][Size(30)] NUMREF: string;         // '000011R'
    [Indexed] FECEMIS: TFechaInt;
    [Size(10)] FECEMISS: string;                // Saint la deja VACIA aqui
    [Decimal(17, 2)] MONTOCOBRADO: TMonto;
    TIPOCOBRO: TIndicador;                      // 0 = efectivo

    [Size(20)] NUMCHETAR: string;
    [Size(15)] CODBANCO: string;
    [Size(15)] CODTAR: string;
    [Size(15)] CODBANCODEP: string;
    [Size(20)] REFERENDEP: string;
    MARCADEP: TIndicador;
    DEPOSITADO: TIndicador;
    OTRAPLAZA: TIndicador;

    HORA: THoraClarion;
    [Indexed][Size(10)] TIPTRAN: string;        // 'FAC', 'DEVxFAC'
    [Size(30)] NUMDOC: string;                  // '000011' sin sufijo
    [Indexed][Size(25)] CODIGO: string;         // cliente
    [Size(60)] DESCRIP1: string;                // 'Factura 000011'
    ESTADOCAJA: TIndicador;
  end;

implementation

end.
